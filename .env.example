# Credenciais da Twitch (Console de Desenvolvedores: https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=seu_client_id_aqui
# Token de usuário com escopo 'user:read:chat'
# Pode ser gerado com o script 'python get_twitch_token.py' ou em https://twitchtokengenerator.com
TWITCH_USER_TOKEN=seu_user_token_aqui

# Canal da Twitch a ser monitorado (nome do streamer, ex: gaules, alanzoka)
TWITCH_CHANNEL=gaules

# Configurações do Detector de Picos (Opcional - padrões recomendados)
WINDOW_SECONDS=10
PEAK_MULTIPLIER=3.0
COOLDOWN_SECONDS=60
CLIP_PRE_SECONDS=30
CLIP_POST_SECONDS=30
